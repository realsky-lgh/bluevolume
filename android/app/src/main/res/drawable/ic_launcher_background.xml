        android:fillAlpha="0.25"
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:startColor="#00F2FE"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>
</vector>
